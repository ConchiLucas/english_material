TASK_CENTER_DB_URL=jdbc:postgresql://host.docker.internal:5432/english_material
TASK_CENTER_DB_USER=postgres
TASK_CENTER_DB_PASSWORD=replace-with-local-password
ENGLISH_MATERIAL_BACKEND_PORT=18744
ENGLISH_MATERIAL_FRONTEND_PORT=19638
# 非密钥；仅用于宿主机本地开发，Context Router 容器使用持久化命名卷内路径。
IMAGE_STORY_STORAGE_ROOT=./runtime/image-story
# 默认保持严格模式；受信任的单用户宿主机开发请通过 scripts/start-dev.sh 显式开启 portable 模式。
IMAGE_STORY_ALLOW_PORTABLE_STORAGE=false
